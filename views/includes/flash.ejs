<% /* FIX: Font Awesome icons avoid corrupted emoji characters on non-UTF-8 terminals. */ %>
<% if (success && success.length) { %>
  <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
    <strong><i class="fa-solid fa-circle-check me-1"></i> Success!</strong> <%= success[0] %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>
<% if (error && error.length) { %>
  <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
    <strong><i class="fa-solid fa-circle-exclamation me-1"></i> Error!</strong> <%= error[0] %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>
